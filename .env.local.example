# Only needed to test the production GitHub-login flow for the CMS locally.
# Local content editing via `npm run cms` does not need these.
#
# Create a GitHub OAuth App at https://github.com/settings/developers with
# callback URL http://localhost:3000/api/callback, then copy this file to
# .env.local and fill in the values it gives you.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
